---
// 首頁:暗底細線 + 單一強調色,依 .agent/features/creator_profile.md
// 版面採雜誌式編排:主要作品逐段圖文交錯,其餘收進附錄清單
const featured = [
  { name: 'Phantasia Engine', year: '2026', tag: '視覺小說引擎', desc: '視覺小說引擎與編輯器。不寫程式,故事自己會走。給有故事想講、但沒有工程能力的人。', status: '開發中', link: '' },
  { name: 'Fabula', year: '2026', tag: 'AI TRPG', desc: '多個 AI 分工的文字冒險。導演、編劇、NPC 各司其職,世界在你行動的空檔偷偷長大。', status: '', link: 'https://fabula.b43096022.workers.dev/' },
  { name: 'PhantomLedger 幻錄', year: '2026', tag: 'TRPG × Roguelike', desc: '一本記錄你做過什麼的書。人格不給數字,結尾唸帳,逐條清算。', status: '開發中', link: '' },
  { name: 'CookTWGame', year: '2026', tag: '光暈戰記同人', desc: '塔防、殭屍生存、RTS、劇情旅途。九個遊戲,同一個世界,持續更新。', status: '持續更新', link: '' },
  { name: 'Ryvexia', year: '2024', tag: '音樂遊戲', desc: '四鍵下落式音game。譜面編輯器附上,曲庫開放投稿。', status: '', link: '' },
];

const others = [
  { name: 'PixiTank', year: '2026', tag: '多人坦克對戰', desc: '八人混戰,子彈會互抵。' },
  { name: 'Dunjo', year: '2026', tag: '平台跳躍', desc: '黑白像素,關卡玩家自己畫。' },
  { name: '小女巫・啟程', year: '2025', tag: '飛行射擊', desc: '鐵人賽三十天寫出來的遊戲。' },
  { name: '五十音 BINGO', year: '2025', tag: '日文小品', desc: '連線之前,先認得它們。' },
  { name: 'CK_TWEventsGame', year: '2021–2024', tag: '光暈戰記同人', desc: '三年,一百二十個版本。' },
];

const links = [
  { name: 'YouTube', url: '#' },
  { name: 'X', url: '#' },
  { name: 'Discord', url: '#' },
  { name: 'GitHub', url: '#' },
];
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>酷可 cook — 遊戲開發與繪畫</title>
    <meta name="description" content="酷可(cook)的作品檔案庫:遊戲、引擎、工具與畫。" />
  </head>
  <body>
    <canvas id="bg"></canvas>

    <main>
      <header class="hero">
        <p class="hero-kicker">GAME DEV / ILLUSTRATION</p>
        <h1>酷可 <span class="latin">cook</span></h1>
        <p class="hero-line">做遊戲,也做讓別人能做遊戲的東西。</p>
        <nav class="links">
          {links.map((l) => <a href={l.url}>{l.name}</a>)}
        </nav>
      </header>

      <section class="works">
        {featured.map((w, i) => (
          <article class={`feature ${i % 2 === 1 ? 'flip' : ''}`}>
            <span class="feature-no">{String(i + 1).padStart(2, '0')}</span>
            <a class="feature-visual" href={w.link || undefined} data-initial={w.name.slice(0, 1)}>
              {w.status && <em class="feature-status">{w.status}</em>}
            </a>
            <div class="feature-text">
              <p class="feature-meta">
                <span class="feature-year">{w.year}</span>
                <span class="feature-tag">{w.tag}</span>
              </p>
              <h3 class="feature-title">
                {w.link ? <a href={w.link}>{w.name}</a> : w.name}
              </h3>
              <p class="feature-desc">{w.desc}</p>
            </div>
          </article>
        ))}
      </section>

      <section class="others">
        <h2>其他作品</h2>
        <ul>
          {others.map((w) => (
            <li>
              <span class="o-year">{w.year}</span>
              <span class="o-name">{w.name}</span>
              <span class="o-desc">{w.desc}</span>
              <span class="o-tag">{w.tag}</span>
            </li>
          ))}
        </ul>
      </section>

      <footer>
        <p>© 2026 酷可 cook</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(html) {
    background: #0c0c0e;
  }
  :global(body) {
    margin: 0;
    color: #d6d3cd;
    font-family: 'Noto Sans TC', 'Microsoft JhengHei', system-ui, sans-serif;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  #bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  main {
    position: relative;
    z-index: 1;
    padding: 0 clamp(1.25rem, 5vw, 5rem);
  }

  .hero {
    padding: 26vh 0 20vh;
  }
  .hero-kicker {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: #6f6a61;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 4.2rem);
    font-weight: 600;
    color: #f0ede6;
  }
  h1 .latin {
    color: #e8b463;
    font-weight: 400;
  }
  .hero-line {
    margin: 0.75rem 0 1.75rem;
    color: #a29d93;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .links a {
    color: #a29d93;
    text-decoration: none;
    font-size: 0.85rem;
    border-bottom: 1px solid #2c2c30;
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .links a:hover {
    color: #e8b463;
    border-color: #e8b463;
  }

  /* 主要作品:圖文交錯的雜誌式編排 */
  .feature {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    margin-bottom: clamp(6rem, 12vh, 10rem);
  }
  .feature-no {
    position: absolute;
    top: -0.6em;
    left: -0.15em;
    z-index: 0;
    font-size: clamp(5rem, 12vw, 9rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px #232327;
    pointer-events: none;
  }
  .flip .feature-no {
    left: auto;
    right: -0.15em;
  }
  .feature-visual {
    position: relative;
    z-index: 1;
    grid-column: 1 / span 8;
    grid-row: 1;
    display: block;
    aspect-ratio: 16 / 8;
    background: linear-gradient(160deg, #17171b 0%, #101013 60%, #131217 100%);
    border: 1px solid #232327;
    clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
    transition: border-color 0.25s;
  }
  .feature-visual::before {
    content: attr(data-initial);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    font-weight: 600;
    color: #232327;
  }
  .feature-visual:hover {
    border-color: #4a3d28;
  }
  .flip .feature-visual {
    grid-column: 5 / span 8;
  }
  .feature-status {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-style: normal;
    font-size: 0.72rem;
    color: #e8b463;
    border: 1px solid #4a3d28;
    background: #0c0c0e;
    padding: 0.1rem 0.5rem;
  }
  .feature-text {
    position: relative;
    z-index: 2;
    grid-column: 8 / span 5;
    grid-row: 1;
    background: #0f0f12;
    border: 1px solid #2c2c30;
    padding: 1.5rem 1.75rem;
    margin-top: 5rem;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
  }
  .flip .feature-text {
    grid-column: 1 / span 5;
  }
  .feature-meta {
    display: flex;
    gap: 0.9rem;
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    color: #6f6a61;
  }
  .feature-year {
    font-variant-numeric: tabular-nums;
  }
  .feature-tag {
    color: #e8b463;
  }
  .feature-title {
    margin: 0 0 0.4rem;
    font-size: 1.35rem;
    font-weight: 600;
    color: #f0ede6;
  }
  .feature-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .feature-title a:hover {
    color: #e8b463;
  }
  .feature-desc {
    margin: 0;
    color: #8b867c;
    font-size: 0.88rem;
  }

  /* 其他作品:附錄式清單 */
  .others {
    max-width: 60rem;
    margin: 0 0 4rem;
  }
  .others h2 {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: #6f6a61;
    margin: 0 0 1rem;
  }
  .others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid #232327;
  }
  .others li {
    display: grid;
    grid-template-columns: 6.5rem 12rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.8rem 0.25rem;
    border-bottom: 1px solid #232327;
  }
  .o-year {
    color: #6f6a61;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .o-name {
    color: #f0ede6;
    font-weight: 500;
    font-size: 0.92rem;
  }
  .o-desc {
    color: #8b867c;
    font-size: 0.83rem;
  }
  .o-tag {
    color: #6f6a61;
    font-size: 0.73rem;
    white-space: nowrap;
  }

  footer {
    padding: 4rem 0 2.5rem;
    color: #55524b;
    font-size: 0.8rem;
  }

  @media (max-width: 820px) {
    .feature {
      display: block;
      margin-bottom: 4.5rem;
    }
    .feature-text {
      margin: -2rem 1rem 0;
    }
    .others li {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'name year' 'desc desc';
    }
    .o-year { grid-area: year; }
    .o-name { grid-area: name; }
    .o-desc { grid-area: desc; }
    .o-tag { display: none; }
  }
</style>

<script>
  // 背景:少量緩慢漂浮的微粒,克制不搶主體
  const canvas = document.getElementById('bg') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let w = 0;
  let h = 0;

  type Mote = { x: number; y: number; r: number; vy: number; a: number };
  let motes: Mote[] = [];

  function resize() {
    w = canvas.width = window.innerWidth * devicePixelRatio;
    h = canvas.height = window.innerHeight * devicePixelRatio;
    canvas.style.width = '100%';
    canvas.style.height = '100%';
    const count = Math.min(40, Math.floor(window.innerWidth / 30));
    motes = Array.from({ length: count }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: (Math.random() * 1.2 + 0.4) * devicePixelRatio,
      vy: (Math.random() * 0.15 + 0.05) * devicePixelRatio,
      a: Math.random() * 0.35 + 0.1,
    }));
  }

  function tick() {
    ctx.clearRect(0, 0, w, h);
    for (const m of motes) {
      m.y -= m.vy;
      if (m.y < -4) {
        m.y = h + 4;
        m.x = Math.random() * w;
      }
      ctx.beginPath();
      ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(232, 180, 99, ${m.a})`;
      ctx.fill();
    }
    requestAnimationFrame(tick);
  }

  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(tick);
</script>
