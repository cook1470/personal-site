      99.4% 22%, 98% 45%, 99.6% 68%, 98.2% 88%, 97% 97.6%,
      80% 99%, 58% 97.4%, 36% 99.4%, 15% 98%, 2.4% 99%,
      0.8% 80%, 2% 58%, 0.4% 34%, 1.6% 12%
    );
    transform: scale(0.8) rotate(-1deg);
