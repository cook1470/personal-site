---
import Hero from '../components/Hero.astro';
import Board from '../components/Board.astro';
import Gallery from '../components/Gallery.astro';
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>酷可 cook — 遊戲開發與繪畫</title>
    <meta name="description" content="酷可(cook)的作品檔案庫:遊戲、引擎、工具與畫。" />
  </head>
  <body>
    <canvas id="bg"></canvas>

    <Hero />

    <main>
      <Board />
      <Gallery />
      <footer>
        <p>© 2026 酷可 cook</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(html) {
    background: #0c0c0e;
  }
  :global(body) {
    margin: 0;
    color: #d6d3cd;
    font-family: 'Noto Sans TC', 'Microsoft JhengHei', system-ui, sans-serif;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  #bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  main {
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 8vh, 6rem) clamp(1.25rem, 4vw, 4rem) 0;
  }
  footer {
    padding: 2rem 0 2.5rem;
    color: #55524b;
    font-size: 0.8rem;
  }
</style>

<script>
  // 背景:地底的金色微粒,克制不搶主體
  const canvas = document.getElementById('bg') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let w = 0;
  let h = 0;

  type Mote = { x: number; y: number; r: number; vy: number; a: number };
  let motes: Mote[] = [];

  function resize() {
    w = canvas.width = window.innerWidth * devicePixelRatio;
    h = canvas.height = window.innerHeight * devicePixelRatio;
    canvas.style.width = '100%';
    canvas.style.height = '100%';
    const count = Math.min(40, Math.floor(window.innerWidth / 30));
    motes = Array.from({ length: count }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: (Math.random() * 1.2 + 0.4) * devicePixelRatio,
      vy: (Math.random() * 0.15 + 0.05) * devicePixelRatio,
      a: Math.random() * 0.35 + 0.1,
    }));
  }

  function tick() {
    ctx.clearRect(0, 0, w, h);
    for (const m of motes) {
      m.y -= m.vy;
      if (m.y < -4) {
        m.y = h + 4;
        m.x = Math.random() * w;
      }
      ctx.beginPath();
      ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(232, 180, 99, ${m.a})`;
      ctx.fill();
    }
    requestAnimationFrame(tick);
  }

  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(tick);
</script>
