---
// 遊戲外殼：一個畫面，像素世界常駐，分頁覆蓋在上。規格見 .agent/features/game_shell.md
import PixelWorld from '../components/shell/PixelWorld.astro';
import MainMenu from '../components/shell/MainMenu.astro';
import WorksPanel from '../components/shell/WorksPanel.astro';
import ArtPanel from '../components/shell/ArtPanel.astro';
import DocsPanel from '../components/shell/DocsPanel.astro';
import AboutPanel from '../components/shell/AboutPanel.astro';
import { articles, mcMaps } from '../data/site';
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <title>酷可 cook — 遊戲開發與繪畫</title>
    <meta name="description" content="酷可(cook)的作品檔案庫：遊戲、引擎、工具與畫。" />
  </head>
  <body>
    <PixelWorld />
    <MainMenu />

    <WorksPanel />
    <ArtPanel />
    <DocsPanel id="docs" title="文" sub="ARTICLES" docs={articles} />
    <DocsPanel id="maps" title="磚" sub="MINECRAFT" docs={mcMaps} />
    <AboutPanel />

    <script src="../scripts/shell.ts"></script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html,
  body {
    height: 100%;
    overflow: hidden;
    margin: 0;
    background: #0c0c0e;
  }
  body {
    font-family: 'Noto Sans TC', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: #e8e4dc;
    -webkit-font-smoothing: antialiased;
  }
  ::selection {
    background: #e8b463;
    color: #14100a;
  }
</style>
