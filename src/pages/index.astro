---
// 首頁 prototype:暗底細線 + 單一強調色,依 .agent/features/creator_profile.md
const works = [
  { name: 'Phantasia Engine', year: '2026', tag: '引擎', desc: '視覺小說引擎與編輯器。不寫程式,故事自己會走。', status: '開發中', link: '', size: 'lg' },
  { name: 'Fabula', year: '2026', tag: 'TRPG', desc: '多個 AI 分工的文字冒險。世界在你行動的空檔偷偷長大。', status: '', link: 'https://fabula.b43096022.workers.dev/', size: 'lg' },
  { name: 'PhantomLedger 幻錄', year: '2026', tag: 'TRPG × Roguelike', desc: '一本記錄你做過什麼的書。結尾唸帳,逐條清算。', status: '開發中', link: '', size: 'md' },
  { name: 'CookTWGame', year: '2026', tag: '光暈同人', desc: '塔防、殭屍、RTS、劇情。九個遊戲,同一個世界。', status: '持續更新', link: '', size: 'md' },
  { name: 'PixiTank', year: '2026', tag: '多人對戰', desc: '八人坦克混戰。子彈會互抵,草叢藏得住人。', status: '', link: '', size: 'md' },
  { name: '小女巫・啟程', year: '2025', tag: '射擊', desc: '橫向飛行射擊。三十天,一篇一篇寫出來的遊戲。', status: '', link: '', size: 'sm' },
  { name: 'Dunjo', year: '2026', tag: '平台跳躍', desc: '黑白像素。關卡是玩家自己畫的。', status: '', link: '', size: 'sm' },
  { name: 'Ryvexia', year: '2024', tag: '音樂遊戲', desc: '四鍵下落式。譜面編輯器附上,曲庫等你投稿。', status: '', link: '', size: 'sm' },
  { name: '五十音 BINGO', year: '2025', tag: '小品', desc: '看片假名,點平假名。連線之前,先認得它們。', status: '', link: '', size: 'sm' },
  { name: 'CK_TWEventsGame', year: '2021–2024', tag: '光暈同人', desc: '三年,一百二十個版本。什麼類型都試過一遍的地方。', status: '', link: '', size: 'md' },
];

const links = [
  { name: 'YouTube', url: '#' },
  { name: 'X', url: '#' },
  { name: 'Discord', url: '#' },
  { name: 'GitHub', url: '#' },
];
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>酷可 cook — 遊戲開發與繪畫</title>
    <meta name="description" content="酷可(cook)的作品檔案庫:遊戲、引擎、工具與畫。" />
  </head>
  <body>
    <canvas id="bg"></canvas>

    <main>
      <header class="hero">
        <p class="hero-kicker">GAME DEV / ILLUSTRATION</p>
        <h1>酷可 <span class="latin">cook</span></h1>
        <p class="hero-line">做遊戲,也做讓別人能做遊戲的東西。</p>
        <nav class="links">
          {links.map((l) => <a href={l.url}>{l.name}</a>)}
        </nav>
      </header>

      <section class="works">
        <h2><span class="mark">錄</span>作品</h2>
        <div class="grid">
          {works.map((w) => (
            <a class={`card card-${w.size}`} href={w.link || undefined}>
              <div class="card-visual" data-initial={w.name.slice(0, 1)}>
                {w.status && <em class="card-status">{w.status}</em>}
              </div>
              <div class="card-body">
                <div class="card-head">
                  <span class="card-title">{w.name}</span>
                  <span class="card-year">{w.year}</span>
                </div>
                <p class="card-desc">{w.desc}</p>
                <span class="card-tag">{w.tag}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <footer>
        <p>© 2026 酷可 cook</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(html) {
    background: #0c0c0e;
  }
  :global(body) {
    margin: 0;
    color: #d6d3cd;
    font-family: 'Noto Sans TC', 'Microsoft JhengHei', system-ui, sans-serif;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  #bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  main {
    position: relative;
    z-index: 1;
    padding: 0 clamp(1.25rem, 4vw, 4rem);
  }

  .hero {
    padding: 24vh 0 16vh;
    max-width: 60rem;
  }
  .hero-kicker {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: #6f6a61;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    font-weight: 600;
    color: #f0ede6;
  }
  h1 .latin {
    color: #e8b463;
    font-weight: 400;
  }
  .hero-line {
    margin: 0.75rem 0 1.75rem;
    color: #a29d93;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .links a {
    color: #a29d93;
    text-decoration: none;
    font-size: 0.85rem;
    border-bottom: 1px solid #2c2c30;
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .links a:hover {
    color: #e8b463;
    border-color: #e8b463;
  }

  .works h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
    font-weight: 500;
    color: #a29d93;
    margin: 0 0 1.5rem;
  }
  .works h2 .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid #e8b463;
    color: #e8b463;
    font-size: 0.9rem;
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.25rem;
  }
  .card-lg {
    grid-column: span 6;
  }
  .card-md {
    grid-column: span 4;
  }
  .card-sm {
    grid-column: span 3;
  }
  .card-lg .card-visual {
    aspect-ratio: 16 / 7;
  }
  .card-sm .card-visual {
    aspect-ratio: 16 / 10;
  }
  .card-sm .card-desc {
    font-size: 0.8rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid #232327;
    background: #101013;
    color: inherit;
    text-decoration: none;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: #4a3d28;
    transform: translateY(-2px);
  }
  .card:hover .card-title {
    color: #e8b463;
  }
  .card-visual {
    position: relative;
    aspect-ratio: 16 / 8;
    background:
      linear-gradient(160deg, #17171b 0%, #101013 60%, #131217 100%);
    border-bottom: 1px solid #232327;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-visual::before {
    content: attr(data-initial);
    font-size: 3rem;
    font-weight: 600;
    color: #232327;
  }
  .card-status {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-style: normal;
    font-size: 0.7rem;
    color: #e8b463;
    border: 1px solid #4a3d28;
    background: #0c0c0e;
    padding: 0.05rem 0.45rem;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem 1.15rem;
    flex: 1;
  }
  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .card-title {
    color: #f0ede6;
    font-weight: 500;
    transition: color 0.2s;
  }
  .card-year {
    color: #6f6a61;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .card-desc {
    margin: 0;
    color: #8b867c;
    font-size: 0.85rem;
    flex: 1;
  }
  .card-tag {
    color: #6f6a61;
    font-size: 0.73rem;
  }

  footer {
    padding: 6rem 0 2.5rem;
    color: #55524b;
    font-size: 0.8rem;
  }

  @media (max-width: 1100px) {
    .card-lg {
      grid-column: span 6;
    }
    .card-md,
    .card-sm {
      grid-column: span 6;
    }
  }
  @media (max-width: 640px) {
    .card-lg,
    .card-md,
    .card-sm {
      grid-column: span 12;
    }
  }
</style>

<script>
  // 背景:少量緩慢漂浮的微粒,克制不搶主體
  const canvas = document.getElementById('bg') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let w = 0;
  let h = 0;

  type Mote = { x: number; y: number; r: number; vy: number; a: number };
  let motes: Mote[] = [];

  function resize() {
    w = canvas.width = window.innerWidth * devicePixelRatio;
    h = canvas.height = window.innerHeight * devicePixelRatio;
    canvas.style.width = '100%';
    canvas.style.height = '100%';
    const count = Math.min(40, Math.floor(window.innerWidth / 30));
    motes = Array.from({ length: count }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: (Math.random() * 1.2 + 0.4) * devicePixelRatio,
      vy: (Math.random() * 0.15 + 0.05) * devicePixelRatio,
      a: Math.random() * 0.35 + 0.1,
    }));
  }

  function tick() {
    ctx.clearRect(0, 0, w, h);
    for (const m of motes) {
      m.y -= m.vy;
      if (m.y < -4) {
        m.y = h + 4;
        m.x = Math.random() * w;
      }
      ctx.beginPath();
      ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(232, 180, 99, ${m.a})`;
      ctx.fill();
    }
    requestAnimationFrame(tick);
  }

  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(tick);
</script>
