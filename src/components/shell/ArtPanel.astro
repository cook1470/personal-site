---
// 繪圖分頁：縮圖牆，點擊回 pixiv 原頁。
import Panel from './Panel.astro';
import { art, PIXIV_HOME } from '../../data/site';
---

<Panel id="art" title="繪圖" sub="ILLUSTRATION" size="lg">
  <div class="wall">
    {art.map((a) => (
      <a class="piece" href={`https://www.pixiv.net/artworks/${a.id}`} target="_blank" rel="noopener">
        <img src={`/images/art/${a.id}.jpg`} alt={a.title} loading="lazy" />
        <span class="cap">{a.title}</span>
      </a>
    ))}
  </div>
  <p class="more">
    <a href={PIXIV_HOME} target="_blank" rel="noopener">更多在 pixiv</a>
  </p>
</Panel>

<style>
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.7rem;
  }
  .piece {
    position: relative;
    display: block;
    overflow: hidden;
    border: 0;
    text-decoration: none;
    box-shadow:
      inset -4px -4px 0 0 rgba(0, 0, 0, 0.55),
      inset 4px 4px 0 0 rgba(107, 79, 42, 0.55);
    transition: transform 100ms;
  }
  .piece:hover {
    transform: translateY(-4px);
    box-shadow:
      inset -4px -4px 0 0 rgba(0, 0, 0, 0.55),
      inset 4px 4px 0 0 #e8b463;
  }
  .piece img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.4rem 0.6rem;
    background: linear-gradient(180deg, transparent, rgba(6, 6, 8, 0.88));
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.9);
    opacity: 0;
    transition: opacity 140ms ease-out;
  }
  .piece:hover .cap {
    opacity: 1;
  }
  .more {
    margin: 1.4rem 0 0;
  }
  .more a {
    font-size: 0.85rem;
    color: #e8b463;
    text-decoration: none;
    border-bottom: 1px solid rgba(232, 180, 99, 0.4);
    padding-bottom: 2px;
  }
  .more a:hover {
    border-color: #e8b463;
  }
</style>
