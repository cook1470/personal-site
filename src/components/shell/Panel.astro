---
// 分頁面板外框。尺寸依內容給,不一律滿版;點面板外面也能關。
interface Props {
  id: string;
  title: string;
  sub?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { id, title, sub, size = 'md' } = Astro.props;
---

<div class="overlay" id={`panel-${id}`} data-panel-id={id} hidden>
  <section class={`panel ${size}`}>
    <header class="head">
      <h2>{title}</h2>
      {sub && <span class="sub">{sub}</span>}
      <button class="close" data-close aria-label="關閉">✕ <span class="esc">ESC</span></button>
    </header>
    <div class="body">
      <slot />
    </div>
  </section>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vh 4vw;
    background: rgba(0, 0, 0, 0.62);
  }
  /* hidden 屬性會輸給 display:flex,必須明寫(見 PITFALLS) */
  .overlay[hidden] {
    display: none;
  }
  .overlay.opening {
    animation: fadeIn 150ms ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: 88vh;
    background: linear-gradient(180deg, rgba(14, 13, 16, 0.92) 0%, rgba(10, 9, 12, 0.95) 100%);
    border: 2px solid rgba(232, 180, 99, 0.3);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.75);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%);
  }
  /* 尺寸依內容給:關於只有幾行字,不該跟作品格子一樣大 */
  .panel.sm {
    width: min(30rem, 100%);
  }
  .panel.md {
    width: min(48rem, 100%);
  }
  .panel.lg {
    width: min(72rem, 100%);
  }
  .overlay.opening .panel {
    animation: panelIn 150ms cubic-bezier(0.2, 0.9, 0.3, 1.1);
  }
  @keyframes panelIn {
    from { opacity: 0; transform: translateY(14px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }

  .head {
    flex: 0 0 auto;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 1.4rem;
    background: rgba(6, 6, 8, 0.8);
    border-bottom: 2px solid rgba(232, 180, 99, 0.24);
  }
  h2 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    color: #f0c37d;
  }
  .sub {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    font-family: ui-monospace, monospace;
    color: rgba(255, 255, 255, 0.4);
  }
  .close {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid rgba(232, 180, 99, 0.45);
    background: transparent;
    color: #e8b463;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
    transition: background 140ms, color 140ms;
  }
  .close:hover {
    background: #e8b463;
    color: #14100a;
  }
  .close .esc {
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    opacity: 0.7;
  }

  .body {
    flex: 1 1 auto;
    overflow: hidden;
    padding: 1.4rem;
  }

  @media (max-width: 640px) {
    .overlay {
      padding: 3vh 3vw;
    }
    .panel {
      max-height: 92vh;
    }
    .head {
      padding: 0.7rem 1rem;
    }
    h2 {
      font-size: 1.25rem;
    }
    .body {
      padding: 1rem;
    }
  }
</style>
