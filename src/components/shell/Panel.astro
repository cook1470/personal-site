---
// 分頁面板外框。像素風硬邊視窗，不用圓角與柔陰影——整站背景是像素世界，
// 視窗若用扁平現代對話框會像網頁。尺寸依內容給，點外面可關。
interface Props {
  id: string;
  title: string;
  sub?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { id, title, sub, size = 'md' } = Astro.props;
---

<div class="overlay" id={`panel-${id}`} data-panel-id={id} hidden>
  <section class={`panel ${size}`}>
    <header class="head">
      <h2>{title}</h2>
      {sub && <span class="sub">{sub}</span>}
      <button class="close" data-close aria-label="關閉">✕</button>
    </header>
    <div class="body">
      <slot />
    </div>
  </section>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5vh 5vw;
    background: rgba(0, 0, 0, 0.62);
  }
  /* hidden 屬性會輸給 display:flex，必須明寫（見 PITFALLS） */
  .overlay[hidden] {
    display: none;
  }
  .overlay.opening {
    animation: fadeIn 150ms ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* 邊框用 box-shadow 疊成階梯硬邊，4px 一階，跟像素世界的 PX 對齊 */
  .panel {
    display: flex;
    flex-direction: column;
    max-height: 86vh;
    background: #1b1620;
    box-shadow:
      0 -4px 0 0 #6b4f2a,
      0 4px 0 0 #6b4f2a,
      -4px 0 0 0 #6b4f2a,
      4px 0 0 0 #6b4f2a,
      0 -8px 0 0 #120e14,
      0 8px 0 0 #120e14,
      -8px 0 0 0 #120e14,
      8px 0 0 0 #120e14;
  }
  .panel.sm {
    width: min(30rem, 100%);
  }
  .panel.md {
    width: min(48rem, 100%);
  }
  .panel.lg {
    width: min(72rem, 100%);
  }
  .overlay.opening .panel {
    animation: panelIn 150ms cubic-bezier(0.2, 0.9, 0.3, 1.1);
  }
  @keyframes panelIn {
    from { opacity: 0; transform: translateY(14px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }

  .head {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0.9rem;
    background: #2b2030;
    border-bottom: 4px solid #6b4f2a;
  }
  h2 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #f0c37d;
  }
  .sub {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    font-family: ui-monospace, monospace;
    color: rgba(255, 255, 255, 0.32);
  }
  /* 像素風方鈕：硬邊、按下往下沉一格，不用圓角 */
  .close {
    margin-left: auto;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: #4a3350;
    color: #f0c37d;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
    box-shadow:
      inset -4px -4px 0 0 #2a1c30,
      inset 4px 4px 0 0 #6a4c74;
  }
  .close:hover {
    background: #e8b463;
    color: #1b1620;
    box-shadow:
      inset -4px -4px 0 0 #a8763c,
      inset 4px 4px 0 0 #f8d9a4;
  }
  .close:active {
    box-shadow:
      inset 4px 4px 0 0 #a8763c,
      inset -4px -4px 0 0 #f8d9a4;
  }

  .body {
    flex: 1 1 auto;
    /* min-height:0 才能讓內容跟著縮，否則超出的部分會被裁掉 */
    min-height: 0;
    overflow: hidden;
    padding: 1.2rem;
  }

  @media (max-width: 640px) {
    .overlay {
      padding: 3vh 3vw;
    }
    .panel {
      max-height: 92vh;
    }
    .head {
      padding: 0.6rem 0.7rem;
    }
    h2 {
      font-size: 1.1rem;
    }
    .body {
      padding: 0.9rem;
    }
  }
</style>
