---
// 關於：不套視窗，整片偏黑的半透明背景，圓框大頭貼置中，資訊在下面。
import { links } from '../../data/site';
---

<div class="about" id="panel-about" data-panel-id="about" data-close-anywhere hidden>
  <div class="inner">
    <img class="avatar" src="/images/cook.jpg" alt="酷可" />
    <h2>酷可 <span class="latin">cook</span></h2>
    <p class="one">平時的興趣就是做遊戲，常常做一些讓別人也可以做遊戲的東西。</p>

    <nav class="contact">
      {links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener">{l.name}</a>
      ))}
      <a href="mailto:b43096022@gmail.com">b43096022@gmail.com</a>
    </nav>
  </div>
</div>

<style>
  .about {
    position: fixed;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    background: rgba(4, 3, 6, 0.9);
    overflow-y: auto;
    scrollbar-width: none;
  }
  .about[hidden] {
    display: none;
  }
  .about::-webkit-scrollbar {
    display: none;
  }
  .about.opening {
    animation: aboutIn 200ms ease-out;
  }
  @keyframes aboutIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 32rem;
  }

  .avatar {
    width: 148px;
    height: 148px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid #e8b463;
    box-shadow: 0 0 0 8px rgba(232, 180, 99, 0.12);
  }

  h2 {
    margin: 1.5rem 0 0;
    font-size: 1.9rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    color: #f0c37d;
  }
  .latin {
    font-weight: 400;
    opacity: 0.8;
  }
  .one {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.3rem;
    margin-top: 2rem;
  }
  .contact a {
    font-size: 0.82rem;
    color: #e8b463;
    text-decoration: none;
    border-bottom: 1px solid rgba(232, 180, 99, 0.3);
    padding-bottom: 2px;
    transition: border-color 140ms;
  }
  .contact a:hover {
    border-color: #e8b463;
  }

  @media (max-width: 600px) {
    .avatar {
      width: 112px;
      height: 112px;
    }
    h2 {
      font-size: 1.5rem;
    }
  }
</style>
