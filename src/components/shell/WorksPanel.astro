---
// 作品分頁：遊戲合集式的格子陣。一次只選中一格，資訊顯示在格子區外面，
// 方向鍵可走、Enter 開啟。不是 card grid（那是網頁的長相）。
import Panel from './Panel.astro';
import { pinned } from '../../data/site';

const PER_PAGE = 6;
const pages = Array.from(
  { length: Math.ceil(pinned.length / PER_PAGE) },
  (_, p) => pinned.slice(p * PER_PAGE, (p + 1) * PER_PAGE),
);
---

<Panel id="works" title="作品" sub="WORKS" size="lg">
  <div class="collection" data-works-grid>
    <div class="pages">
      {pages.map((page, p) => (
        <div class="page" data-page={p} hidden={p !== 0}>
          {page.map((w, i) => (
            <button class="slot" data-work={w.id} data-index={p * PER_PAGE + i}>
              {w.img
                ? <img src={w.img} alt="" loading="lazy" />
                : <span class="noshot">{w.name.slice(0, 1)}</span>}
              <span class="cursor"></span>
            </button>
          ))}
        </div>
      ))}
    </div>

    <div class="readout">
      {pinned.map((w, i) => (
        <div class="line" data-readout={i} hidden={i !== 0}>
          <span class="r-name">{w.name}</span>
          <span class="r-meta">{w.year} · {w.tag}{w.status ? ` · ${w.status}` : ''}</span>
          <span class="r-desc">{w.desc}</span>
        </div>
      ))}
    </div>

    {pages.length > 1 && (
      <div class="pager">
        <button class="page-btn" data-page-step="-1">前一頁</button>
        <span class="dots">
          {pages.map((_, p) => <span class="dot" data-dot={p}></span>)}
        </span>
        <button class="page-btn" data-page-step="1">下一頁</button>
      </div>
    )}
  </div>

  {pinned.map((w) => (
    <article class="detail" data-detail={w.id} hidden>
      <div class="media">
        {w.video
          ? <div class="video" data-video={w.video}></div>
          : w.img && <img class="d-shot" src={w.img} alt={w.name} />}
      </div>
      <div class="info">
        <p class="d-meta">{w.year} · {w.tag}{w.status ? ` · ${w.status}` : ''}</p>
        <h3>{w.name}</h3>
        <p class="d-desc">{w.desc}</p>
        {w.features && (
          <ul class="features">
            {w.features.map((f) => <li>{f}</li>)}
          </ul>
        )}
        <div class="actions">
          <a class="go-btn" href={w.link} target="_blank" rel="noopener">前往</a>
          {w.link2 && <a class="go-btn alt" href={w.link2} target="_blank" rel="noopener">{w.link2Label ?? '另一個'}</a>}
          <button class="back" data-back>返回</button>
        </div>
      </div>
    </article>
  ))}
</Panel>

<style>
  .collection {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    height: 100%;
  }
  .collection[hidden] {
    display: none;
  }

  /* 一頁六格。作品變多就多一頁，不是把格子越擠越小 */
  .pages {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
  }
  .page {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 10px;
  }
  .page[hidden] {
    display: none;
  }

  .pager {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .page-btn {
    padding: 0.35rem 1rem;
    border: 0;
    background: #4a3350;
    color: #f0c37d;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    box-shadow:
      inset -4px -4px 0 0 rgba(0, 0, 0, 0.45),
      inset 4px 4px 0 0 rgba(255, 255, 255, 0.2);
  }
  .page-btn:hover {
    background: #5c4164;
  }
  .page-btn:active {
    box-shadow:
      inset 4px 4px 0 0 rgba(0, 0, 0, 0.45),
      inset -4px -4px 0 0 rgba(255, 255, 255, 0.2);
  }
  .dots {
    display: flex;
    gap: 6px;
    margin: 0 auto;
  }
  .dot {
    width: 10px;
    height: 10px;
    background: #3a3142;
  }
  .dot.on {
    background: #e8b463;
  }
  .slot {
    position: relative;
    min-height: 0;
    padding: 0;
    border: 0;
    background: #16121a;
    cursor: pointer;
    overflow: hidden;
    box-shadow:
      inset -4px -4px 0 0 #0c090e,
      inset 4px 4px 0 0 #2e2536;
    transition: transform 100ms;
  }
  .slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.5) brightness(0.58);
    transition: filter 100ms;
  }
  .noshot {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: 1.8rem;
    color: rgba(232, 180, 99, 0.3);
  }
  /* 選取框：只有被選中的格子亮起來，像遊戲選單的游標 */
  .cursor {
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 4px transparent;
    pointer-events: none;
  }
  .slot.on img {
    filter: none;
  }
  .slot.on .cursor {
    box-shadow: inset 0 0 0 4px #e8b463;
  }
  .slot.on {
    transform: translateY(-4px);
  }

  .readout {
    padding: 0.75rem 0.9rem;
    background: #16121a;
    box-shadow:
      inset -4px -4px 0 0 #0c090e,
      inset 4px 4px 0 0 #2e2536;
  }
  .line[hidden] {
    display: none;
  }
  .line {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.8rem;
  }
  .r-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f0c37d;
  }
  .r-meta {
    align-self: center;
    font-family: ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
  }
  .r-desc {
    grid-column: 1 / -1;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .detail[hidden] {
    display: none;
  }
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    animation: detailIn 150ms cubic-bezier(0.2, 0.9, 0.3, 1.1);
  }
  @keyframes detailIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  .d-shot,
  .video {
    width: 100%;
    box-shadow:
      inset -4px -4px 0 0 rgba(0, 0, 0, 0.5),
      inset 4px 4px 0 0 rgba(107, 79, 42, 0.6);
  }
  .d-shot {
    display: block;
  }
  .video {
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .video :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .d-meta {
    margin: 0 0 0.3rem;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.45);
  }
  .detail h3 {
    margin: 0 0 0.4rem;
    font-size: 1.7rem;
    font-weight: 900;
    color: #f0c37d;
  }
  .d-desc {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .features {
    margin: 0 0 1.2rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .features li {
    padding-left: 0.85rem;
    border-left: 4px solid #6b4f2a;
    font-size: 0.84rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }
  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .go-btn,
  .back {
    padding: 0.5rem 1.3rem;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: 0;
    box-shadow:
      inset -4px -4px 0 0 rgba(0, 0, 0, 0.45),
      inset 4px 4px 0 0 rgba(255, 255, 255, 0.28);
    transition: background 100ms;
  }
  .go-btn:active,
  .back:active {
    box-shadow:
      inset 4px 4px 0 0 rgba(0, 0, 0, 0.45),
      inset -4px -4px 0 0 rgba(255, 255, 255, 0.28);
  }
  .go-btn {
    background: #e8b463;
    color: #14100a;
  }
  .go-btn:hover {
    background: #f4cd8c;
  }
  .go-btn.alt,
  .back {
    background: #4a3350;
    color: #f0c37d;
  }
  .go-btn.alt:hover,
  .back:hover {
    background: #5c4164;
  }

  @media (max-width: 900px) {
    .page {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(3, 1fr);
    }
    .detail {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
  @media (max-width: 560px) {
    .page {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
