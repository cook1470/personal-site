---
// 作品分頁：音遊選曲列表的形式（用戶自己做過 Ryvexia）。左邊大圖與資訊，
// 右邊垂直清單，選中的往左突出。全畫面，不套視窗。作品變多清單就往下長。
import { pinned } from '../../data/site';
---

<div class="works" id="panel-works" data-panel-id="works" hidden>
  <button class="quit" data-close aria-label="關閉">✕</button>

  <div class="stage">
    {pinned.map((w, i) => (
      <div class="view" data-view={i} hidden={i !== 0}>
        <div class="shot">
          {w.img
            ? <img src={w.img} alt={w.name} />
            : <span class="noshot">{w.name}</span>}
        </div>
        <div class="info">
          <p class="meta">{w.year} · {w.tag}{w.status ? ` · ${w.status}` : ''}</p>
          <h3>{w.name}</h3>
          <p class="desc">{w.desc}</p>
          <div class="links">
            <a class="go" href={w.link} target="_blank" rel="noopener">前往</a>
            {w.link2 && (
              <a class="go alt" href={w.link2} target="_blank" rel="noopener">
                {w.link2Label ?? '另一個'}
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="list">
    <div class="rail" data-rail>
      {pinned.map((w, i) => (
        <button class="row" data-work={w.id} data-index={i}>
          <span class="r-name">{w.name}</span>
          <span class="r-meta">{w.year} · {w.tag}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .works {
    position: fixed;
    inset: 0;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 27rem;
    gap: 1.5rem;
    align-items: center;
    padding: 4.5rem 2.5rem 3rem 4rem;
    background: rgba(8, 6, 10, 0.95);
  }
  .works[hidden] {
    display: none;
  }
  .works.opening {
    animation: worksIn 180ms ease-out;
  }
  @keyframes worksIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .quit {
    position: absolute;
    top: 1.4rem;
    right: 1.6rem;
    width: 34px;
    height: 34px;
    border: 0;
    background: #4a3350;
    color: #f0c37d;
    font-size: 0.95rem;
    cursor: pointer;
    box-shadow:
      inset -4px -4px 0 0 #2a1c30,
      inset 4px 4px 0 0 #6a4c74;
  }
  .quit:hover {
    background: #e8b463;
    color: #1b1620;
  }

  /* 左側：整張圖完整顯示，不裁切 */
  .stage {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .view[hidden] {
    display: none;
  }
  .view {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    width: 100%;
    animation: viewIn 260ms cubic-bezier(0.2, 0.9, 0.3, 1.15);
  }
  @keyframes viewIn {
    from { opacity: 0; transform: translateX(-18px); }
    to { opacity: 1; transform: none; }
  }
  .shot {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    max-height: 64vh;
  }
  .shot img {
    width: 100%;
    max-height: 64vh;
    object-fit: contain;
    display: block;
    outline: 4px solid #6b4f2a;
  }
  .noshot {
    padding: 3rem 2rem;
    background: #241d2a;
    color: rgba(232, 180, 99, 0.5);
    outline: 4px solid #6b4f2a;
  }
  .meta {
    margin: 0 0 0.3rem;
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.45);
  }
  .info h3 {
    margin: 0 0 0.5rem;
    font-size: 2.1rem;
    font-weight: 900;
    color: #f0c37d;
  }
  .desc {
    margin: 0 0 1.1rem;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .links {
    display: flex;
    gap: 0.6rem;
  }
  .go {
    padding: 0.5rem 1.4rem;
    background: #e8b463;
    color: #14100a;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow:
      inset -4px -4px 0 0 rgba(0, 0, 0, 0.4),
      inset 4px 4px 0 0 rgba(255, 255, 255, 0.3);
  }
  .go:hover {
    background: #f4cd8c;
  }
  .go:active {
    box-shadow:
      inset 4px 4px 0 0 rgba(0, 0, 0, 0.4),
      inset -4px -4px 0 0 rgba(255, 255, 255, 0.3);
  }
  .go.alt {
    background: #4a3350;
    color: #f0c37d;
  }
  .go.alt:hover {
    background: #5c4164;
  }

  /* 右側：選中的往左突出，清單跟著捲動讓它保持在中間 */
  .list {
    position: relative;
    height: 100%;
    /* 左邊留出突出的空間，否則選中那列往左移會被 overflow 裁掉字 */
    padding-left: 2.5rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(transparent, #000 4%, #000 96%, transparent);
  }
  .rail {
    position: absolute;
    top: 0;
    left: 2.5rem;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 260ms cubic-bezier(0.2, 0.9, 0.3, 1.15);
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    height: 62px;
    padding: 0 1.1rem;
    justify-content: center;
    border: 0;
    background: #221b28;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow:
      inset -4px -4px 0 0 #150f1a,
      inset 4px 4px 0 0 #352b3e;
    transition: transform 180ms cubic-bezier(0.2, 0.9, 0.3, 1.15),
      background 180ms ease-out;
  }
  .row:hover {
    background: #2e2436;
    transform: translateX(-10px);
  }
  .row.on {
    background: #e8b463;
    transform: translateX(-26px);
    box-shadow:
      inset -4px -4px 0 0 #a8763c,
      inset 4px 4px 0 0 #f8dfae;
  }
  .r-name {
    font-size: 1rem;
    font-weight: 700;
    color: #f0c37d;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .r-meta {
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
  }
  .row.on .r-name {
    color: #1b1206;
  }
  .row.on .r-meta {
    color: rgba(27, 18, 6, 0.6);
  }

  @media (max-width: 900px) {
    .works {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) 40%;
      gap: 1rem;
      padding: 3.5rem 1.2rem 1.2rem;
    }
    .info h3 {
      font-size: 1.5rem;
    }
    .shot,
    .shot img {
      max-height: 30vh;
    }
  }
</style>
