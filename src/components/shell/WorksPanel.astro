---
// 作品分頁：一排三張卡（縮圖＋標題＋一句簡述），點開是霧面玻璃背景的大圖詳情。
import { pinned } from '../../data/site';
---

<div class="works" id="panel-works" data-panel-id="works" hidden>
  <header class="bar">
    <h2>作品</h2>
    <span class="count">{pinned.length}</span>
    <button class="quit" data-close aria-label="關閉">✕</button>
  </header>

  <div class="cards">
    {pinned.map((w, i) => (
      <button class="card" data-work={w.id} data-index={i} style={`--d:${i * 40}ms`}>
        <span class="thumb">
          {w.img
            ? <img src={w.img} alt="" loading="lazy" />
            : <span class="nothumb">{w.name}</span>}
          {w.status && <span class="flag">{w.status}</span>}
        </span>
        <span class="body">
          <span class="c-name">{w.name}</span>
          <span class="c-meta">{w.year} · {w.tag}</span>
          <span class="c-desc">{w.desc}</span>
        </span>
      </button>
    ))}
  </div>
</div>

<div class="glass" data-detail-layer hidden>
  {pinned.map((w, i) => (
    <article class="sheet" data-detail={i} hidden>
      <div class="big">
        {w.img
          ? <img src={w.img} alt={w.name} />
          : <span class="nothumb big-none">{w.name}</span>}
      </div>
      <div class="text">
        <p class="d-meta">{w.year} · {w.tag}{w.status ? ` · ${w.status}` : ''}</p>
        <h3>{w.name}</h3>
        <p class="d-desc">{w.desc}</p>
        {w.features && (
          <ul class="features">
            {w.features.map((f) => <li>{f}</li>)}
          </ul>
        )}
        <div class="links">
          <a class="go" href={w.link} target="_blank" rel="noopener">前往</a>
          {w.link2 && (
            <a class="go alt" href={w.link2} target="_blank" rel="noopener">
              {w.link2Label ?? '另一個'}
            </a>
          )}
          <button class="go alt" data-detail-close>關閉</button>
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  .works {
    position: fixed;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    padding: 1.6rem clamp(1.2rem, 5vw, 4rem) 2rem;
    background: rgba(8, 6, 10, 0.94);
  }
  .works[hidden] {
    display: none;
  }
  .works.opening {
    animation: fade 160ms ease-out;
  }
  @keyframes fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .bar {
    flex: 0 0 auto;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.2rem;
    border-bottom: 4px solid #6b4f2a;
  }
  .bar h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    color: #f0c37d;
  }
  .count {
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.35);
  }
  .quit {
    margin-left: auto;
    width: 32px;
    height: 32px;
    border: 0;
    background: #4a3350;
    color: #f0c37d;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow:
      inset -4px -4px 0 0 #2a1c30,
      inset 4px 4px 0 0 #6a4c74;
  }
  .quit:hover {
    background: #e8b463;
    color: #1b1620;
  }

  /* 一排最多三張，內容多了就往下捲，捲軸藏起來 */
  .cards {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem 1.5rem;
    align-content: start;
    padding-bottom: 0.5rem;
  }
  .cards::-webkit-scrollbar {
    display: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 0;
    background: #201a26;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    box-shadow:
      inset -4px -4px 0 0 #130e18,
      inset 4px 4px 0 0 #322740;
    transition: transform 160ms cubic-bezier(0.2, 0.9, 0.3, 1.15),
      background 160ms ease-out;
    animation: cardIn 300ms cubic-bezier(0.2, 0.9, 0.3, 1.15) backwards;
    animation-delay: var(--d);
  }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  .card:hover,
  .card:focus-visible {
    background: #2c2333;
    transform: translateY(-5px);
    outline: none;
  }

  /* 縮圖整張顯示不裁切：截圖的重點在哪張圖上都不一樣，裁了就抓不到 */
  .thumb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 104px;
    padding: 8px;
    background: #191420;
    overflow: hidden;
  }
  .thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 260ms cubic-bezier(0.2, 0.9, 0.3, 1.15);
  }
  .card:hover .thumb img {
    transform: scale(1.04);
  }
  .nothumb {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 1rem;
    font-size: 0.9rem;
    color: rgba(232, 180, 99, 0.4);
  }
  /* 貼齊角落會被卡片的內陰影邊框吃掉一角，往內縮 */
  .flag {
    position: absolute;
    left: 6px;
    top: 6px;
    padding: 0.18rem 0.5rem;
    background: #e8b463;
    color: #1b1206;
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.7rem 0.9rem 0.85rem;
  }
  .c-name {
    font-size: 1rem;
    font-weight: 700;
    color: #f0c37d;
  }
  .c-meta {
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.38);
  }
  .c-desc {
    margin-top: 0.15rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }

  /* 詳情：霧面玻璃 */
  .glass {
    position: fixed;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vh 4vw;
    background: rgba(10, 8, 12, 0.55);
    backdrop-filter: blur(14px) saturate(0.9);
    -webkit-backdrop-filter: blur(14px) saturate(0.9);
    animation: fade 180ms ease-out;
  }
  .glass[hidden] {
    display: none;
  }

  .sheet[hidden] {
    display: none;
  }
  .sheet {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.8rem;
    align-items: center;
    max-width: 68rem;
    max-height: 88vh;
    padding: 1.6rem;
    background: rgba(24, 20, 30, 0.82);
    border: 4px solid #6b4f2a;
    outline: 4px solid rgba(10, 8, 12, 0.6);
    animation: sheetIn 220ms cubic-bezier(0.2, 0.9, 0.3, 1.18);
  }
  @keyframes sheetIn {
    from { opacity: 0; transform: translateY(18px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  .big img {
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    display: block;
  }
  .big-none {
    aspect-ratio: 16 / 9;
    background: #241d2a;
  }
  .d-meta {
    margin: 0 0 0.3rem;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.45);
  }
  .text h3 {
    margin: 0 0 0.5rem;
    font-size: 1.9rem;
    font-weight: 900;
    color: #f0c37d;
  }
  .d-desc {
    margin: 0 0 1rem;
    font-size: 0.98rem;
    color: rgba(255, 255, 255, 0.86);
  }
  .features {
    margin: 0 0 1.2rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    max-height: 34vh;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .features::-webkit-scrollbar {
    display: none;
  }
  .features li {
    padding-left: 0.8rem;
    border-left: 4px solid #6b4f2a;
    font-size: 0.83rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }
  .links {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .go {
    padding: 0.45rem 1.2rem;
    border: 0;
    background: #e8b463;
    color: #14100a;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow:
      inset -4px -4px 0 0 rgba(0, 0, 0, 0.4),
      inset 4px 4px 0 0 rgba(255, 255, 255, 0.3);
  }
  .go:hover {
    background: #f4cd8c;
  }
  .go:active {
    box-shadow:
      inset 4px 4px 0 0 rgba(0, 0, 0, 0.4),
      inset -4px -4px 0 0 rgba(255, 255, 255, 0.3);
  }
  .go.alt {
    background: #4a3350;
    color: #f0c37d;
  }
  .go.alt:hover {
    background: #5c4164;
  }

  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .sheet {
      grid-template-columns: 1fr;
      gap: 1rem;
      overflow-y: auto;
    }
    .big img {
      max-height: 34vh;
    }
  }
  @media (max-width: 600px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
