---
// 作品分頁：垂直長條並排，沿用用戶自己做過的橫幅形式（求職履歷與 FB 橫幅）。
// 斜切、選中展開顯示資訊、再點一次收起。作品變多就多一條，不需要格子或翻頁。
import Panel from './Panel.astro';
import { pinned } from '../../data/site';
---

<Panel id="works" title="作品" sub="WORKS" size="lg" fill>
  <div class="strips">
    {pinned.map((w, i) => (
      <div class="strip" role="button" tabindex="0" data-work={w.id} data-index={i} style={`--d:${i * 45}ms`}>
        <span class="pic">
          {w.img
            ? <img src={w.img} alt="" loading="lazy" />
            : <span class="noshot"></span>}
        </span>

        <span class="spine">
          <span class="spine-name">{w.name}</span>
        </span>

        <span class="card">
          <span class="c-meta">{w.year} · {w.tag}{w.status ? ` · ${w.status}` : ''}</span>
          <span class="c-name">{w.name}</span>
          <span class="c-desc">{w.desc}</span>
          <span class="c-links">
            <a class="c-go" href={w.link} target="_blank" rel="noopener">前往</a>
            {w.link2 && (
              <a class="c-go alt" href={w.link2} target="_blank" rel="noopener">
                {w.link2Label ?? '另一個'}
              </a>
            )}
          </span>
        </span>
      </div>
    ))}
  </div>
</Panel>

<style>
  /* 整排往左斜，條子裡的內容再斜回來，圖與字才不會跟著歪 */
  .strips {
    display: flex;
    gap: 6px;
    height: 100%;
    padding: 0 3.2rem;
    transform: skewX(-7deg);
  }

  .strip {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    padding: 0;
    border: 0;
    background: #120f16;
    cursor: pointer;
    overflow: hidden;
    outline: 3px solid #241d2a;
    transition: flex-grow 340ms cubic-bezier(0.2, 0.9, 0.3, 1.15),
      outline-color 200ms ease-out;
    animation: stripIn 380ms cubic-bezier(0.2, 0.9, 0.3, 1.15) backwards;
    animation-delay: var(--d);
  }
  /* 進場一條一條落下，不是整排一起淡入 */
  @keyframes stripIn {
    from { transform: translateY(-14%); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
  .strip:hover {
    outline-color: #6b4f2a;
  }
  .strip.open {
    flex-grow: 5;
    outline-color: #e8b463;
  }

  .pic {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .pic img,
  .noshot {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    /* 圖反斜回正，順便放大蓋住斜切後露出的邊 */
    transform: skewX(7deg) scale(1.35);
    filter: saturate(0.45) brightness(0.5);
    transition: filter 260ms ease-out, transform 340ms cubic-bezier(0.2, 0.9, 0.3, 1.15);
  }
  .noshot {
    background: linear-gradient(160deg, #2a2230, #16121a);
  }
  .strip:hover .pic img {
    filter: saturate(0.7) brightness(0.68);
  }
  .strip.open .pic img {
    filter: none;
    transform: skewX(7deg) scale(1.12);
  }

  /* 未展開時名字直排貼在條子底部 */
  .spine {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.7rem 0.2rem;
    display: flex;
    justify-content: center;
    background: linear-gradient(transparent, rgba(8, 6, 10, 0.92));
    transform: skewX(7deg);
    transition: opacity 160ms ease-out;
  }
  .spine-name {
    font-size: 0.78rem;
    font-weight: 700;
    color: #f0c37d;
    writing-mode: vertical-rl;
    letter-spacing: 0.12em;
    max-height: 9rem;
    overflow: hidden;
  }
  .strip.open .spine {
    opacity: 0;
  }

  .card {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.2rem 1.2rem;
    text-align: left;
    background: linear-gradient(transparent, rgba(8, 6, 10, 0.88) 22%, rgba(8, 6, 10, 0.96));
    transform: skewX(7deg) translateY(12px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease-out, transform 260ms cubic-bezier(0.2, 0.9, 0.3, 1.15);
  }
  .strip.open .card {
    opacity: 1;
    transform: skewX(7deg) translateY(0);
    pointer-events: auto;
    transition-delay: 120ms;
  }
  .c-meta {
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
  }
  .c-name {
    font-size: 1.35rem;
    font-weight: 900;
    color: #f0c37d;
    white-space: nowrap;
  }
  .c-desc {
    font-size: 0.86rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }
  .c-links {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .c-go {
    padding: 0.4rem 1.1rem;
    background: #e8b463;
    color: #14100a;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      inset -4px -4px 0 0 rgba(0, 0, 0, 0.4),
      inset 4px 4px 0 0 rgba(255, 255, 255, 0.3);
  }
  .c-go:hover {
    background: #f4cd8c;
  }
  .c-go:active {
    box-shadow:
      inset 4px 4px 0 0 rgba(0, 0, 0, 0.4),
      inset -4px -4px 0 0 rgba(255, 255, 255, 0.3);
  }
  .c-go.alt {
    background: #4a3350;
    color: #f0c37d;
  }
  .c-go.alt:hover {
    background: #5c4164;
  }

  @media (max-width: 900px) {
    .strips {
      padding: 0 1.6rem;
      gap: 4px;
    }
    .strip.open {
      flex-grow: 7;
    }
    .c-name {
      font-size: 1.1rem;
    }
  }
</style>
