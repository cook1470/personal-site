---
// 作品分頁:格子陳列 → 點開詳情。素材只有縮圖,所以格子主體是文案,截圖退成底圖。
import Panel from './Panel.astro';
import { pinned } from '../../data/site';
---

<Panel id="works" title="作品" sub="WORKS">
  <div class="grid" data-works-grid>
    {pinned.map((w, i) => (
      <button class="cell" data-work={w.id}>
        {w.img && <span class="shot" style={`background-image:url(${w.img})`}></span>}
        <span class="cell-in">
          <span class="meta">
            <span class="year">{w.year}</span>
            <span class="tag">{w.tag}</span>
          </span>
          <span class="name">{w.name}</span>
          <span class="desc">{w.desc}</span>
          {w.status && <span class="status">{w.status}</span>}
        </span>
      </button>
    ))}
  </div>

  {pinned.map((w) => (
    <article class="detail" data-detail={w.id} hidden>
      <button class="back" data-back>← 返回</button>
      <p class="d-meta">{w.year} · {w.tag}{w.status ? ` · ${w.status}` : ''}</p>
      <h3>{w.name}</h3>
      <p class="d-desc">{w.desc}</p>
      {w.video && (
        <div class="video" data-video={w.video}></div>
      )}
      {!w.video && w.img && <img class="d-shot" src={w.img} alt={w.name} />}
      {w.features && (
        <ul class="features">
          {w.features.map((f) => <li>{f}</li>)}
        </ul>
      )}
      <div class="go">
        <a class="go-btn" href={w.link} target="_blank" rel="noopener">前往 →</a>
        {w.link2 && <a class="go-btn alt" href={w.link2} target="_blank" rel="noopener">{w.link2Label ?? '另一個'} →</a>}
      </div>
    </article>
  ))}
</Panel>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.9rem;
  }
  .cell {
    position: relative;
    display: block;
    overflow: hidden;
    padding: 0;
    border: 1px solid rgba(232, 180, 99, 0.22);
    background: rgba(20, 18, 22, 0.6);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%);
    transition: border-color 140ms ease-out, transform 140ms ease-out, background 140ms ease-out;
  }
  .cell:hover,
  .cell:focus-visible {
    border-color: #e8b463;
    background: rgba(36, 30, 20, 0.75);
    transform: translateY(-3px);
    outline: none;
  }
  .shot {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.16;
    transition: opacity 140ms ease-out;
  }
  .cell:hover .shot {
    opacity: 0.28;
  }
  .cell-in {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.95rem 1rem 1.1rem;
    min-height: 118px;
  }
  .meta {
    display: flex;
    gap: 0.6rem;
    font-family: ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.42);
  }
  .name {
    font-family: 'Noto Serif TC', serif;
    font-size: 1.12rem;
    font-weight: 700;
    color: #f0c37d;
  }
  .desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.5;
  }
  .status {
    margin-top: auto;
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: #8fb98f;
  }

  .detail[hidden] {
    display: none;
  }
  .detail {
    max-width: 46rem;
    animation: detailIn 150ms cubic-bezier(0.2, 0.9, 0.3, 1.1);
  }
  @keyframes detailIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  .back {
    margin-bottom: 1.1rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid rgba(232, 180, 99, 0.4);
    background: transparent;
    color: #e8b463;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    clip-path: polygon(8px 0, 100% 0, 100% 100%, 0 100%);
    transition: background 140ms, color 140ms;
  }
  .back:hover {
    background: #e8b463;
    color: #14100a;
  }
  .d-meta {
    margin: 0 0 0.3rem;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.45);
  }
  .detail h3 {
    margin: 0 0 0.5rem;
    font-family: 'Noto Serif TC', serif;
    font-size: 1.9rem;
    font-weight: 900;
    color: #f0c37d;
  }
  .d-desc {
    margin: 0 0 1.2rem;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .d-shot,
  .video {
    width: 100%;
    margin-bottom: 1.2rem;
    border: 1px solid rgba(232, 180, 99, 0.25);
  }
  .video {
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .video :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .features {
    margin: 0 0 1.4rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .features li {
    padding-left: 0.95rem;
    border-left: 2px solid rgba(232, 180, 99, 0.45);
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
  }
  .go {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .go-btn {
    padding: 0.5rem 1.3rem;
    background: #e8b463;
    color: #14100a;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
    transition: transform 140ms ease-out, background 140ms;
  }
  .go-btn:hover {
    transform: translateX(4px);
    background: #f4cd8c;
  }
  .go-btn.alt {
    background: transparent;
    border: 1px solid rgba(232, 180, 99, 0.5);
    color: #e8b463;
  }
  .go-btn.alt:hover {
    background: rgba(232, 180, 99, 0.15);
  }
</style>
